#!/usr/bin/env bash
# Prepares a fresh Amp orb: installs the pinned pnpm and the locked dependencies.
set -euo pipefail
cd "$(dirname "$0")/.."

step() { echo "==> $1"; SECONDS=0; }
done_step() { echo "    done in ${SECONDS}s"; }

# Match the pnpm version pinned in package.json (and used by CI).
pnpm_version="$(node -p 'require("./package.json").packageManager.split("@")[1]')"
step "Ensuring pnpm $pnpm_version"
if [ "$(pnpm -v 2>/dev/null || true)" != "$pnpm_version" ]; then
  npm install -g --no-fund --no-audit "pnpm@$pnpm_version"
fi
done_step

step "Installing dependencies"
pnpm install --frozen-lockfile
done_step
